# Mẫu tham khảo. Đặt giá trị thật trong biến môi trường, không lưu key vào repo.
RAG_LLM_MODEL=gemini-3.5-flash-lite
RAG_LLM_FALLBACK_MODELS=
# Giao diện web: danh sách model cho người dùng chọn, ví dụ gemini-3.6-flash,gemini-3.5-flash-lite.
RAG_LLM_MODELS=
# RAG_LLM_OFFLINE=1: chỉ phát lại cache; cần model, không cần URL hoặc khóa API.
RAG_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
RAG_LLM_API_KEY=
RAG_OCR_MODEL=
RAG_JUDGE_MODEL=
RAG_TESSERACT_EXE=
RAG_TESSDATA_DIR=
